{
  "name": "roomguide",
  "private": true,
  "version": "0.1.0",
  "description": "Room Guide — spatial narration for low-vision users. Meta Global AI Hackathon entry.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @roomguide/web",
    "build": "npm run build -w @roomguide/core && npm run build -w @roomguide/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/core apps/web",
    "eval": "tsx eval/run.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
